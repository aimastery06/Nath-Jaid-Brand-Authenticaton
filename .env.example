# Copy to .env for local development. Never commit real values.
# Local values: `npm run db:start` prints the Supabase URL and keys; `npm run stripe:listen` prints the webhook secret.

# Absolute site URL (canonical URLs, Open Graph, Stripe return URLs)
SITE_URL=http://localhost:4321

# Supabase. The site uses whichever project SUPABASE_URL names:
#   hosted: https://<project-ref>.supabase.co (Project Settings → Data API), then `npm run db:connect`
#           sets that project up and fills in blank or mismatched keys below
#   local:  http://127.0.0.1:55421 with the keys `npm run db:start` prints
# Keys: Project Settings → API Keys. Legacy anon / service_role keys also work.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional, only read by `npm run db:connect` (Project Settings → Database). Leave blank to be asked instead.
SUPABASE_DB_PASSWORD=

# Stripe (Developers → API keys, and the webhook endpoint's signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
