{
  "name": "nath-jaid",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "logos": "node scripts/build-logos.mjs",
    "dev": "npm run logos && astro dev",
    "build": "npm run logos && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:connect": "node scripts/connect-supabase.mjs",
    "db:types":"supabase gen types typescript --local > src/lib/server/database.types.ts",
    "stripe:listen": "stripe listen --forward-to localhost:4321/api/stripe/webhook --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,charge.refunded,charge.dispute.created",
    "admin:grant": "node --env-file=.env scripts/grant-admin.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --env-file=.env --test \"tests/integration/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.13",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "astro": "^7.3.8",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "supabase": "^2.120.0",
    "typescript": "^6.0.3"
  }
}
