---
import { company } from '../data/company';
---

<div class="announcement on-dark">
  <p class="container">Complimentary shipping on orders of ${company.freeShippingThreshold} or more.</p>
</div>

<style>
  .announcement p {
    padding-block: 0.6rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-align: center;
  }

  @media (max-width: 400px) {
    .announcement p {
      font-size: 0.75rem;
      letter-spacing: 0.02em;
    }
  }

  @media (max-width: 359px) {
    .announcement p {
      font-size: 0.6875rem;
      letter-spacing: 0;
    }
  }
</style>
