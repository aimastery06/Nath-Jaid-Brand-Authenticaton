---
// Narrow single-column frame for sign-in, sign-up, and password pages (brand/website-direction.md, "Account Pages").
interface Props {
  heading: string;
  lead?: string;
}

const { heading, lead } = Astro.props;
---

<section class="auth section">
  <div class="container">
    <div class="auth-inner">
      <header class="auth-header">
        <h1>{heading}</h1>
        {lead && <p class="lead muted">{lead}</p>}
      </header>
      <slot />
    </div>
  </div>
</section>

<style>
  .auth-inner {
    display: grid;
    gap: 2rem;
    max-width: 28rem;
    margin-inline: auto;
  }

  .auth-header {
    display: grid;
    gap: 0.75rem;
  }

  .auth-inner :global(form) {
    display: grid;
    gap: 1.25rem;
  }

  .auth-inner :global(.form-alert) {
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--color-fall-terracotta);
    background: var(--color-soft-ivory);
  }

  .auth-inner :global(.form-notice) {
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--color-warm-gold);
    background: var(--color-soft-ivory);
  }

  .auth-inner :global(.auth-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--fs-small);
  }

  .auth-inner :global(.auth-rule) {
    border: 0;
    border-top: 1px solid var(--color-rule);
  }
</style>
