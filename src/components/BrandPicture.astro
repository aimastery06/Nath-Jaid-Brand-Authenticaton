---
// Optimized photography from brand/product/images/: AVIF with a WebP fallback at responsive widths.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Ratio = 'product' | 'campaign' | 'story';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio: Ratio;
  sizes: string;
  /** Load first (hero, product primary image); everything else lazy-loads. */
  priority?: boolean;
  class?: string;
}

const { src, alt, ratio, sizes, priority = false, class: className } = Astro.props;

const widthSets: Record<Ratio, number[]> = {
  product: [320, 480, 640, 800, 1122],
  campaign: [640, 960, 1280, 1672],
  story: [640, 960, 1280, 1536],
};
const widths = widthSets[ratio].filter((w) => w <= src.width);
---

<div class:list={['image-frame', `image-frame--${ratio}`, className]}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>
