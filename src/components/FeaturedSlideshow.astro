---
// One slide per candle, opening on the featured candle. Never auto-rotates.
import BrandPicture from './BrandPicture.astro';
import Button from './Button.astro';
import ScentNotes from './ScentNotes.astro';
import { formatPrice, getCollectionProducts, getMood, productHref } from '../data/catalog';
import type { Collection } from '../data/types';

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const products = getCollectionProducts(collection);
const start = Math.max(0, products.findIndex((p) => p.slug === collection.featured));
const total = products.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section
  class="slideshow section"
  aria-roledescription="carousel"
  aria-labelledby="slideshow-heading"
  data-slideshow
  data-start={start}
>
  <div class="container">
    <h2 id="slideshow-heading" class="sr-only">Featured candles from {collection.name}</h2>

    <div class="slideshow-frame">
      <div class="slides" data-slides>
        {
          products.map((product, i) => {
            const active = i === start;
            return (
              <div
                class:list={['slide', { 'is-active': active }]}
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${total}: ${product.name}`}
                aria-hidden={active ? undefined : 'true'}
                inert={!active}
                data-slide
                data-name={product.name}
              >
                {product.images[0] && (
                  <BrandPicture
                    src={product.images[0].src}
                    alt={product.images[0].alt}
                    ratio="product"
                    sizes="(min-width: 1024px) 520px, (min-width: 640px) 70vw, calc(100vw - 2rem)"
                    class="slide-media"
                  />
                )}
                <div class="slide-copy">
                  <p class="eyebrow">{getMood(collection, product.mood).name}</p>
                  <h3 class="slide-name">{product.name}</h3>
                  <p class="slide-story serif">{product.story}</p>
                  <p class="muted">{product.description}</p>
                  <ScentNotes notes={product.notes} compact />
                  <div class="slide-buy">
                    <p class="price">{formatPrice(product.price)}</p>
                    <Button href={productHref(product)}>Discover {product.name}</Button>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>

      <div class="controls" data-controls>
        <button type="button" class="arrow" data-prev aria-label="Previous candle">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <p class="counter" aria-hidden="true">
          <span data-counter>{pad(start + 1)}</span> / {pad(total)}
        </p>
        <button type="button" class="arrow" data-next aria-label="Next candle">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <ul class="dots">
          {
            products.map((product, i) => (
              <li>
                <button
                  type="button"
                  class="dot"
                  style={`--swatch: ${product.accent}`}
                  aria-label={`Show ${product.name}`}
                  aria-current={i === start ? 'true' : undefined}
                  data-dot={i}
                >
                  <span aria-hidden="true" />
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="sr-only" aria-live="polite" aria-atomic="true" data-announcer></p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const announcer = root.querySelector<HTMLElement>('[data-announcer]');
    const slidesEl = root.querySelector<HTMLElement>('[data-slides]');
    let index = Number(root.dataset.start) || 0;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.inert = !active;
        if (active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (counter) counter.textContent = String(index + 1).padStart(2, '0');
      if (announcer) announcer.textContent = `${index + 1} of ${slides.length}: ${slides[index]?.dataset.name ?? ''}`;
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      }
    });

    // Swipe on touch and pen; ignore mostly vertical gestures so page scrolling still works.
    let startX = 0;
    let startY = 0;
    slidesEl?.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      startX = event.clientX;
      startY = event.clientY;
    });
    slidesEl?.addEventListener('pointerup', (event) => {
      if (event.pointerType === 'mouse') return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) show(dx < 0 ? index + 1 : index - 1);
    });
  });
</script>

<style>
  .slideshow-frame {
    display: grid;
    gap: 2rem;
  }

  .slides {
    display: grid;
    touch-action: pan-y;
  }

  .slide {
    grid-area: 1 / 1;
    display: grid;
    gap: 2rem;
    align-content: start;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s var(--ease), visibility 0s linear 0.5s;
  }

  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s var(--ease), visibility 0s;
  }

  .slide-copy {
    display: grid;
    gap: 1rem;
    align-content: center;
    max-width: 34rem;
  }

  .slide-name { font-size: var(--fs-h2); }

  .slide-story {
    font-size: var(--fs-story);
    line-height: 1.3;
    color: var(--color-evergreen);
  }

  .slide-buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }

  .slide-buy .price { font-size: 1.125rem; }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.25rem;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-control-border);
    border-radius: 50%;
    background: transparent;
    color: var(--color-evergreen);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .arrow:hover {
    background: var(--color-evergreen);
    border-color: var(--color-evergreen);
    color: var(--color-warm-cream);
  }

  .counter {
    min-width: 3.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .dots {
    display: flex;
    margin-left: auto;
    padding: 0;
    list-style: none;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
  }

  /* Evergreen ring keeps every vessel color visible against Cream. */
  .dot span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: 0 0 0 1px var(--color-warm-cream), 0 0 0 2px var(--color-control-border);
  }

  .dot[aria-current='true'] span {
    transform: scale(1.25);
    box-shadow: 0 0 0 2px var(--color-warm-cream), 0 0 0 3px var(--color-evergreen);
  }

  @media (min-width: 640px) {
    .slide :global(.slide-media) { max-width: 30rem; }
  }

  @media (min-width: 1024px) {
    .slideshow-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }

    .slides {
      grid-column: 1 / -1;
      grid-row: 1;
      grid-template-columns: subgrid;
    }

    .slide {
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      column-gap: inherit;
    }

    .slide :global(.slide-media) { max-width: none; }

    /* Leave room beneath the copy for the shared controls. */
    .slide-copy { padding-bottom: 6rem; }

    .controls {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      z-index: 1;
    }

    .dots { margin-left: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide.is-active { transition: none; }
  }
</style>
