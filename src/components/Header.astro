---
import { accountLink, bagLink, primaryNav } from '../data/navigation';
import { company } from '../data/company';

const normalize = (path: string) => (path.length > 1 ? path.replace(/\/$/, '') : path);
const current = normalize(Astro.url.pathname);
const isCurrent = (href: string) => !href.includes('#') && normalize(href) === current;
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      <span class="sr-only">Menu</span>
    </button>

    <a href="/" class="logo">
      <img src="/brand/logo-header.svg" alt={`${company.name} — Home`} width="950" height="148" />
    </a>

    <nav aria-label="Main" class="desktop-nav">
      <ul>
        {
          primaryNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
    <!-- Signed out: a link to sign in that returns here. Signed in: the visitor's name, opening a small menu.
         Pages are prerendered, so the script below fills this in from /api/session. -->
    <div class="account-menu" data-account>
      <a
        href={accountLink.href}
        class="action-link account-link"
        aria-current={current.startsWith(accountLink.href) ? 'page' : undefined}
        data-account-link
      >
        <svg class="action-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="12" cy="8.5" r="3.5"></circle>
          <path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5" stroke-linecap="round"></path>
        </svg>
        <span class="action-text">{accountLink.label}</span>
      </a>
      <button
        type="button"
        class="action-link account-toggle"
        aria-expanded="false"
        aria-controls="account-panel"
        data-account-toggle
        hidden
      >
        <svg class="action-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="12" cy="8.5" r="3.5"></circle>
          <path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5" stroke-linecap="round"></path>
        </svg>
        <span class="action-text" data-account-name>{accountLink.label}</span>
        <span class="sr-only">, account menu</span>
        <svg class="caret" aria-hidden="true" viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <div id="account-panel" class="account-panel" data-account-panel hidden>
        <p class="account-panel-meta">Signed in as <span data-account-email></span></p>
        <a href={accountLink.href} class="account-panel-item">Your account</a>
        <form method="post" action="/account/sign-out">
          <button type="submit" class="account-panel-item">Sign out</button>
        </form>
      </div>
    </div>

    <a
      href={bagLink.href}
      class="action-link bag-link"
      aria-current={isCurrent(bagLink.href) ? 'page' : undefined}
      data-bag-link
    >
      <svg class="action-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M5 8h14l-1 12.5H6L5 8Z" stroke-linejoin="round"></path>
        <path d="M9 10.5V7a3 3 0 0 1 6 0v3.5" stroke-linecap="round"></path>
      </svg>
      <span class="action-text">{bagLink.label}</span>
      <span class="bag-count" data-bag-count hidden></span>
    </a>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        {
          [...primaryNav, accountLink, bagLink].map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                data-account-link={link === accountLink ? '' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li data-mobile-sign-out hidden>
          <form method="post" action="/account/sign-out">
            <button type="submit">Sign out</button>
          </form>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { bagCount, clearBag, hasSessionCookie, onBagChange, readBag, syncBagOwner } from '../scripts/bag';

  // Bag count
  const bagLinkEl = document.querySelector<HTMLAnchorElement>('[data-bag-link]');
  const countEl = document.querySelector<HTMLElement>('[data-bag-count]');
  const renderCount = () => {
    const count = bagCount(readBag());
    if (!bagLinkEl || !countEl) return;
    countEl.textContent = String(count);
    countEl.hidden = count === 0;
    bagLinkEl.setAttribute('aria-label', count ? `Bag, ${count} ${count === 1 ? 'item' : 'items'}` : 'Bag');
  };
  renderCount();
  onBagChange(renderCount);

  // Signing out empties the bag, so the next person on this browser doesn't see it.
  document.addEventListener('submit', (event) => {
    if ((event.target as HTMLFormElement).getAttribute('action') === '/account/sign-out') clearBag();
  });

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      if (!open && returnFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) setOpen(false, true);
    });
    window.matchMedia('(min-width: 960px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Account menu and bag owner. Visitors without a Supabase session cookie never call the server; for
  // everyone else /api/session verifies the session and says whose it is.
  const account = document.querySelector<HTMLElement>('[data-account]');
  const accountToggle = account?.querySelector<HTMLButtonElement>('[data-account-toggle]');
  const accountPanel = account?.querySelector<HTMLElement>('[data-account-panel]');
  const desktopAccountLink = account?.querySelector<HTMLAnchorElement>('[data-account-link]');
  const accountLinks = document.querySelectorAll<HTMLAnchorElement>('[data-account-link]');
  const mobileSignOut = document.querySelector<HTMLElement>('[data-mobile-sign-out]');

  if (account && accountToggle && accountPanel && desktopAccountLink) {
    const setPanelOpen = (open: boolean, returnFocus = false) => {
      accountToggle.setAttribute('aria-expanded', String(open));
      accountPanel.hidden = !open;
      if (!open && returnFocus) accountToggle.focus();
    };

    const showSignedOut = () => {
      setPanelOpen(false);
      accountToggle.hidden = true;
      desktopAccountLink.hidden = false;
      if (mobileSignOut) mobileSignOut.hidden = true;
      // Signing in returns to this page, so visitors carry on where they were.
      const here = location.pathname + location.search;
      const href = here.startsWith('/account') ? '/account' : `/account/sign-in?next=${encodeURIComponent(here)}`;
      accountLinks.forEach((link) => (link.href = href));
    };

    const showSignedIn = (firstName: string | null, email: string | null) => {
      account.querySelector('[data-account-name]')!.textContent = firstName ?? 'Account';
      account.querySelector('[data-account-email]')!.textContent = email ?? '';
      desktopAccountLink.hidden = true;
      accountToggle.hidden = false;
      if (mobileSignOut) mobileSignOut.hidden = false;
      accountLinks.forEach((link) => (link.href = '/account'));
    };

    const refresh = async () => {
      showSignedOut();
      if (!hasSessionCookie()) {
        syncBagOwner(null);
        return;
      }
      try {
        const response = await fetch('/api/session', { cache: 'no-store' });
        if (!response.ok) return;
        const { account: signedIn } = await response.json();
        syncBagOwner(signedIn?.id ?? null);
        if (signedIn) showSignedIn(signedIn.firstName, signedIn.email);
      } catch {
        // Leave the plain Account link; the account pages check the session themselves.
      }
    };

    accountToggle.addEventListener('click', () => setPanelOpen(accountToggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('click', (event) => {
      if (!accountPanel.hidden && !account.contains(event.target as Node)) setPanelOpen(false);
    });
    account.addEventListener('focusout', (event) => {
      if (!accountPanel.hidden && !account.contains(event.relatedTarget as Node | null)) setPanelOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !accountPanel.hidden) setPanelOpen(false, true);
    });
    // Pages restored from the back/forward cache may predate a sign-in or sign-out.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) refresh();
    });
    refresh();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-warm-cream);
    border-bottom: 1px solid var(--color-rule);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--header-height);
  }

  /* Mobile: menu left, logo centered, bag right */
  .menu-toggle {
    justify-self: start;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -0.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-evergreen);
  }

  .menu-icon {
    display: grid;
    gap: 6px;
    width: 1.375rem;
  }

  .menu-icon span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s var(--ease);
  }

  .menu-toggle[aria-expanded='true'] .menu-icon span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-icon span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  .logo {
    justify-self: center;
    display: block;
    padding-block: 0.5rem;
  }

  .logo img {
    width: clamp(9rem, 38vw, 11rem);
    height: auto;
  }

  .desktop-nav { display: none; }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    margin-right: -0.5rem;
  }

  .action-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    justify-content: center;
    padding-inline: 0.5rem;
    color: var(--color-evergreen);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .action-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .bag-count {
    position: absolute;
    top: 0.2rem;
    right: 0.05rem;
    display: grid;
    place-items: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding-inline: 0.25rem;
    border-radius: 999px;
    background: var(--color-evergreen);
    color: var(--color-warm-cream);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .account-menu {
    position: relative;
    display: flex;
  }

  .account-toggle {
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .caret { display: none; }

  .account-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 60;
    width: max-content;
    min-width: 15rem;
    max-width: min(20rem, calc(100vw - 2rem));
    padding-block: 0.5rem;
    background: var(--color-soft-ivory);
    border: 1px solid var(--color-rule);
    box-shadow: 0 14px 32px -18px color-mix(in srgb, var(--color-charcoal) 40%, transparent);
  }

  .account-panel-meta {
    margin: 0 0 0.25rem;
    padding: 0.5rem 1.25rem 0.75rem;
    border-bottom: 1px solid var(--color-rule);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .account-panel-meta span {
    display: block;
    color: var(--color-charcoal);
    font-weight: 500;
  }

  .account-panel form { margin: 0; }

  .account-panel-item {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--color-evergreen);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .account-panel-item:hover { background: var(--color-warm-cream); }

  .mobile-menu {
    position: absolute;
    inset: 100% 0 auto;
    max-height: calc(100vh - var(--header-height));
    overflow-y: auto;
    background: var(--color-warm-cream);
    border-bottom: 1px solid var(--color-rule);
  }

  .mobile-menu ul {
    padding: 0.5rem var(--gutter) 2rem;
    list-style: none;
  }

  .mobile-menu li + li { border-top: 1px solid var(--color-rule); }

  .mobile-menu a,
  .mobile-menu button {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 3.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--color-evergreen);
    text-decoration: none;
  }

  .mobile-menu a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-warm-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  /* Desktop: logo left, links centered, bag right */
  @media (min-width: 960px) {
    .menu-toggle,
    .mobile-menu { display: none !important; }

    .logo {
      grid-column: 1;
      justify-self: start;
    }

    .logo img { width: clamp(10.5rem, 15vw, 13rem); }

    .desktop-nav { display: block; grid-column: 2; }

    .desktop-nav ul {
      display: flex;
      gap: clamp(1.5rem, 2.6vw, 2.75rem);
      padding: 0;
      list-style: none;
    }

    .desktop-nav a,
    .action-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      color: var(--color-evergreen);
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
    }

    .desktop-nav a::after,
    .action-link::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.45rem;
      height: 1px;
      background: var(--color-warm-gold);
      opacity: 0;
    }

    .desktop-nav a:hover::after,
    .desktop-nav a[aria-current='page']::after,
    .action-link:hover::after,
    .action-link[aria-current='page']::after,
    .account-toggle[aria-expanded='true']::after { opacity: 1; }

    .caret { display: block; }

    .header-actions {
      grid-column: 3;
      gap: clamp(1.5rem, 2.6vw, 2.75rem);
      margin-right: 0;
    }

    .action-link {
      min-width: 0;
      padding-inline: 0;
      gap: 0.5rem;
    }

    .action-text {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }

    .action-icon { display: none; }

    .bag-count {
      position: static;
      min-width: 1.35rem;
      height: 1.35rem;
    }
  }
</style>
