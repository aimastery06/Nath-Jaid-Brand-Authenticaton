---
import Button from './Button.astro';
// Copy from brand/website-direction.md ("Newsletter Band"). Confirms on the page only until a provider is connected.
---

<section class="newsletter bg-ivory section" aria-labelledby="newsletter-heading">
  <div class="container newsletter-inner">
    <div class="newsletter-copy">
      <p class="eyebrow">Early access</p>
      <h2 id="newsletter-heading">Be the first to know when a new season arrives.</h2>
      <p class="muted">Join the list for early access to future collections and limited releases.</p>
    </div>

    <div class="newsletter-form-wrap">
      <form class="newsletter-form" data-validate novalidate>
        <div class="field">
          <label for="newsletter-email">Email address</label>
          <div class="newsletter-row">
            <input
              id="newsletter-email"
              name="email"
              type="email"
              class="input"
              autocomplete="email"
              required
              data-required-message="Please enter your email address."
              aria-describedby="newsletter-email-error"
            />
            <Button type="submit">Sign up</Button>
          </div>
          <p id="newsletter-email-error" class="field-error" hidden></p>
        </div>
      </form>
      <p class="form-success" tabindex="-1" data-form-success hidden>
        Thank you — you're on the list. We'll write when the next season arrives.
      </p>
    </div>
  </div>
</section>

<script>
  import '../scripts/forms';
</script>

<style>
  .newsletter-inner {
    display: grid;
    gap: 2rem;
  }

  .newsletter-copy {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }

  .newsletter-row {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 560px) {
    .newsletter-row { grid-template-columns: 1fr auto; }
  }

  @media (min-width: 960px) {
    .newsletter-inner {
      grid-template-columns: 1.1fr 1fr;
      align-items: end;
      gap: 4rem;
    }
  }
</style>
