---
// Items and totals for one order: checkout confirmation, account order detail, and admin.
// Names and prices are the snapshots stored with the order, not today's catalog.
import { Image } from 'astro:assets';
import { getProduct, productHref } from '../data/catalog';
import { formatCents } from '../lib/commerce';

interface Item {
  product_slug: string;
  name: string;
  unit_price_cents: number;
  quantity: number;
}

interface Props {
  items: Item[];
  subtotalCents: number;
  shippingCents: number;
  taxCents: number;
  totalCents: number;
  refundedCents?: number;
}

const { items, subtotalCents, shippingCents, taxCents, totalCents, refundedCents = 0 } = Astro.props;
---

<div class="order-summary">
  <ul class="order-items" aria-label="Items">
    {
      items.map((item) => {
        const product = getProduct(item.product_slug);
        const image = product?.images[0];
        return (
          <li class="order-item">
            <div class="thumb">
              {image && <Image src={image.src} alt="" width={160} height={200} format="webp" loading="lazy" />}
            </div>
            <div class="order-item-info">
              <p class="order-item-name serif">
                {product ? <a href={productHref(product)}>{item.name}</a> : item.name}
              </p>
              <p class="muted">Quantity {item.quantity} · {formatCents(item.unit_price_cents)} each</p>
            </div>
            <p class="price">{formatCents(item.unit_price_cents * item.quantity)}</p>
          </li>
        );
      })
    }
  </ul>

  <dl class="order-totals">
    <div><dt>Subtotal</dt><dd class="price">{formatCents(subtotalCents)}</dd></div>
    <div><dt>Shipping</dt><dd class="price">{shippingCents === 0 ? 'Complimentary' : formatCents(shippingCents)}</dd></div>
    {taxCents > 0 && <div><dt>Sales tax</dt><dd class="price">{formatCents(taxCents)}</dd></div>}
    <div class="grand"><dt>Total</dt><dd class="price">{formatCents(totalCents)}</dd></div>
    {refundedCents > 0 && <div><dt>Refunded</dt><dd class="price">−{formatCents(refundedCents)}</dd></div>}
  </dl>
</div>

<style>
  .order-summary {
    display: grid;
    gap: 1.5rem;
  }

  .order-items {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  .order-item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .thumb {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-soft-ivory);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .order-item-name {
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--color-evergreen);
  }

  .order-item-name a {
    color: inherit;
    text-decoration: none;
  }

  .order-item-name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-warm-gold);
    text-underline-offset: 0.2em;
  }

  .order-item-info .muted { font-size: var(--fs-small); }

  .order-totals {
    display: grid;
    gap: 0.5rem;
  }

  .order-totals div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .order-totals dd { margin: 0; }

  .order-totals .grand {
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-rule);
    font-weight: 500;
  }

  .order-totals .grand dd { font-size: 1.25rem; }
</style>
