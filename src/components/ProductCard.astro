---
import BrandPicture from './BrandPicture.astro';
import { formatPrice, formatShortNotes, productHref } from '../data/catalog';
import type { Product } from '../data/types';

interface Props {
  product: Product;
  /** Responsive `sizes` for the card image; defaults to the 2 → 4 column grid. */
  sizes?: string;
}

const {
  product,
  sizes = '(min-width: 1360px) 300px, (min-width: 1024px) calc((100vw - 8rem) / 4), calc((100vw - 3rem) / 2)',
} = Astro.props;
const [primary] = product.images;
---

<article class="product-card" data-mood={product.mood}>
  {primary && <BrandPicture src={primary.src} alt={primary.alt} ratio="product" sizes={sizes} class="card-media" />}
  <div class="card-body">
    <h3 class="card-name"><a href={productHref(product)}>{product.name}</a></h3>
    <p class="card-notes">{formatShortNotes(product.shortNotes)}</p>
    <p class="price">
      {formatPrice(product.price)}<span class="stock-note" data-stock-note={product.slug} hidden></span>
    </p>
  </div>
</article>

<script>
  import { loadStock, stockCopy } from '../scripts/stock';

  // Sold-out and low-stock notes sit inline with the price so they never shift the layout.
  loadStock().then((stock) => {
    document.querySelectorAll<HTMLElement>('[data-stock-note]').forEach((note) => {
      const status = stock[note.dataset.stockNote ?? ''];
      if (status === 'low' || status === 'sold_out') {
        note.textContent = ` · ${stockCopy[status]}`;
        note.hidden = false;
      }
    });
  });
</script>

<style>
  .product-card {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .product-card :global(.card-media img) { transition: transform 0.6s var(--ease); }

  .product-card:hover :global(.card-media img) { transform: scale(1.025); }

  .card-body {
    display: grid;
    gap: 0.3rem;
  }

  .card-name { font-size: var(--fs-h3); }

  .card-name a {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is clickable through the name link. */
  .card-name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-name a:focus-visible { outline: none; }

  .card-name a:focus-visible::after {
    outline: 2px solid var(--color-evergreen);
    outline-offset: 4px;
  }

  .product-card:hover .card-name a {
    text-decoration: underline;
    text-decoration-color: var(--color-warm-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .card-notes {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .price { font-size: 0.9375rem; }

  .stock-note {
    font-weight: 400;
    color: var(--color-text-muted);
  }
</style>
