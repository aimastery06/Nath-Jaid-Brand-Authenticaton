---
// 4:5 primary image. Thumbnails appear automatically when a product has more than one approved image.
import { Picture } from 'astro:assets';
import BrandPicture from './BrandPicture.astro';
import type { ProductImage } from '../data/types';

interface Props {
  images: ProductImage[];
  name: string;
}

const { images, name } = Astro.props;
const sizes = '(min-width: 1360px) 640px, (min-width: 960px) 48vw, calc(100vw - 2rem)';
---

<div class="gallery" data-gallery>
  <div class="gallery-main">
    {
      images.map((image, i) => (
        <div data-gallery-image hidden={i > 0}>
          <BrandPicture src={image.src} alt={image.alt} ratio="product" sizes={sizes} priority={i === 0} />
        </div>
      ))
    }
  </div>

  {
    images.length > 1 && (
      <ul class="thumbs" aria-label={`${name} images`}>
        {images.map((image, i) => (
          <li>
            <button
              type="button"
              class="thumb"
              aria-label={`Show image ${i + 1} of ${images.length}`}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-gallery-thumb={i}
            >
              <Picture
                src={image.src}
                alt=""
                widths={[120, 240]}
                sizes="120px"
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                loading="lazy"
              />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const images = Array.from(root.querySelectorAll<HTMLElement>('[data-gallery-image]'));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
    thumbs.forEach((thumb, i) =>
      thumb.addEventListener('click', () => {
        images.forEach((image, j) => (image.hidden = j !== i));
        thumbs.forEach((t, j) => t.setAttribute('aria-pressed', String(j === i)));
      }),
    );
  });
</script>

<style>
  .thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .thumb {
    width: 4.5rem;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 1px solid transparent;
    background: var(--color-soft-ivory);
    overflow: hidden;
  }

  .thumb[aria-pressed='true'] { border-color: var(--color-evergreen); }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
