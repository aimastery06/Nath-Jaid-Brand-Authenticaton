---
import { getMoodProducts } from '../data/catalog';
import { getSeason } from '../data/seasons';
import type { Collection } from '../data/types';

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const seasonName = (getSeason(collection.season)?.name ?? collection.season).toLowerCase();
const tiles = collection.moods.map((mood) => ({ mood, products: getMoodProducts(collection, mood.slug) }));
---

<section class="moods bg-ivory section" aria-labelledby="moods-heading">
  <div class="container">
    <header class="moods-header">
      <p class="eyebrow">Find your {seasonName}</p>
      <h2 id="moods-heading">Shop by scent mood</h2>
    </header>

    <ul class="mood-tiles">
      {
        tiles.map(({ mood, products }) => (
          <li>
            <a class="mood-tile" href={`${collection.route}?mood=${mood.slug}#shop`}>
              <span class="mood-swatches" aria-hidden="true">
                {products.map((p) => (
                  <span class="swatch" style={`--swatch: ${p.accent}`} />
                ))}
              </span>
              <span class="mood-name serif">{mood.name}</span>
              <span class="mood-cue">{mood.cue}</span>
              <span class="mood-candles">{products.map((p) => p.name).join(', ')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .moods-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .mood-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .mood-tile {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem 0 0.5rem;
    border-top: 1px solid var(--color-rule);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.25s var(--ease);
  }

  .mood-tile:hover { border-top-color: var(--color-evergreen); }

  .mood-swatches {
    display: flex;
    gap: 0.35rem;
  }

  .mood-name {
    font-size: var(--fs-h3);
    line-height: 1.15;
    color: var(--color-evergreen);
  }

  .mood-tile:hover .mood-name {
    text-decoration: underline;
    text-decoration-color: var(--color-warm-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .mood-cue {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .mood-candles {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-evergreen);
  }

  @media (min-width: 640px) {
    .mood-tiles { gap: 1.5rem; }
  }

  @media (min-width: 1024px) {
    .mood-tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
  }
</style>
