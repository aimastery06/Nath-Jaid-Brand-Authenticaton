---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandPicture from '../components/BrandPicture.astro';
import Button from '../components/Button.astro';
import { activeCollection } from '../data/catalog';
import { company } from '../data/company';
import { ourStoryImage } from '../data/brand-images';
import { seasons } from '../data/seasons';
---

<BaseLayout
  title="Our Story"
  description={`${company.name} creates candles inspired by seasons, memories, moods, and everyday moments — introduced in focused seasonal collections.`}
>
  <section class="intro section" aria-labelledby="story-heading">
    <div class="container intro-inner">
      <p class="eyebrow">Our Story</p>
      <h1 id="story-heading">Fragrance that creates a feeling.</h1>
      <p class="lead muted">
        {company.name} is a modern home-fragrance brand that creates candles inspired by seasons, memories, moods, and
        everyday moments.
      </p>
    </div>
  </section>

  <BrandPicture src={ourStoryImage.src} alt={ourStoryImage.alt} ratio="story" sizes="100vw" />

  <section class="moments bg-ivory section" aria-labelledby="moments-heading">
    <div class="container two-col">
      <h2 id="moments-heading">Fragrance for the moments you want to keep.</h2>
      <div class="prose">
        <p>
          Our candles are made to change a room the moment they are lit — to make a home feel warmer, calmer, brighter,
          and more personal.
        </p>
        <p>
          Each scent begins with a place, a season, or a memory: a cool evening with the windows open, a warm kitchen, a
          quiet room with nowhere else to be.
        </p>
        <blockquote class="mission">
          <p class="serif">{company.mission}</p>
          <footer class="eyebrow">Our mission</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="promise section" aria-labelledby="promise-heading">
    <div class="container">
      <header class="promise-header">
        <p class="eyebrow">Our promise</p>
        <h2 id="promise-heading">Every candle should offer three things.</h2>
      </header>
      <ol class="promise-list">
        {
          company.promise.map((item, i) => (
            <li>
              <span class="promise-number serif" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{item.title}</h3>
              <p class="muted">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="approach on-dark section" aria-labelledby="approach-heading">
    <div class="container two-col">
      <div class="approach-copy">
        <p class="eyebrow">Our approach</p>
        <h2 id="approach-heading">A scent for every season.</h2>
        <p>
          Rather than offering the same scents all year, we introduce focused collections for seasons and occasions —
          each one made to be anticipated, enjoyed, and remembered.
        </p>
        <p class="muted">Now: {activeCollection.name}. {activeCollection.description}</p>
      </div>

      <div class="approach-seasons">
        <ul class="season-list">
          {
            seasons.map((season) => {
              const isNow = season.slug === activeCollection.season;
              return (
                <li class:list={{ 'is-now': isNow }}>
                  <span class="season-swatches" aria-hidden="true">
                    {season.accents.map((accent) => (
                      <span class="swatch" style={`--swatch: ${accent.hex}`} title={accent.name} />
                    ))}
                  </span>
                  <span class="season-name serif">{season.name}</span>
                  {isNow && <span class="now">Now</span>}
                </li>
              );
            })
          }
        </ul>
        <Button href={activeCollection.route} onDark>Shop {activeCollection.name.replace(/^The /, 'the ')}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-bottom: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }

  .intro-inner {
    display: grid;
    gap: 1rem;
  }

  .intro-inner > * { max-width: 46rem; }

  .two-col {
    display: grid;
    gap: 2rem;
  }

  .mission {
    margin-top: 2rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-warm-gold);
  }

  .mission p {
    font-size: var(--fs-story);
    line-height: 1.3;
    color: var(--color-evergreen);
  }

  .mission footer { margin-top: 1rem; }

  .promise-header {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .promise-list {
    display: grid;
    gap: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .promise-list li {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }

  .promise-number {
    font-size: 1.125rem;
    color: var(--color-evergreen);
  }

  .approach-copy {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
  }

  .approach-seasons {
    display: grid;
    justify-items: start;
    gap: 2.5rem;
  }

  .season-list {
    display: grid;
    width: 100%;
    padding: 0;
    list-style: none;
  }

  .season-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-rule-on-dark);
  }

  .season-list li:first-child { border-top: 1px solid var(--color-rule-on-dark); }

  .season-swatches {
    display: flex;
    gap: 0.35rem;
  }

  .season-swatches .swatch {
    width: 0.875rem;
    height: 0.875rem;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-warm-cream) 55%, transparent);
  }

  .season-name { font-size: 1.5rem; }

  .now {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-warm-gold);
  }

  @media (min-width: 768px) {
    .promise-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media (min-width: 960px) {
    .two-col {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
  }
</style>
