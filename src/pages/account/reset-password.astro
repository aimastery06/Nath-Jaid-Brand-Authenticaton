---
// Sends a password-reset link. The reply never reveals whether an account exists.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import { EMAIL_PATTERN, confirmUrl, field, type FieldErrors } from '../../lib/server/forms';

export const prerender = false;

const { supabase } = Astro.locals;
const errors: FieldErrors = {};
let email = '';
let sentTo = '';

if (Astro.request.method === 'POST' && supabase) {
  const form = await Astro.request.formData();
  email = field(form, 'email');
  if (!EMAIL_PATTERN.test(email)) {
    errors.email = 'Please enter an email address like name@example.com.';
  } else {
    await supabase.auth.resetPasswordForEmail(email, { redirectTo: confirmUrl(Astro.url, '/account/update-password') });
    sentTo = email;
  }
}
---

<BaseLayout title="Reset your password" description="Reset your NATH & JAID account password." noindex>
  <AuthShell
    heading={sentTo ? 'Check your inbox.' : 'Reset your password.'}
    lead={sentTo ? undefined : "Enter your email and we'll send you a link to choose a new password."}
  >
    {
      sentTo ? (
        <p class="form-notice" role="status">
          If there's an account for {sentTo}, we've sent it a link to choose a new password.
        </p>
      ) : (
        <form method="post" data-validate="submit" novalidate aria-label="Reset your password">
          <FormField
            id="email"
            name="email"
            type="email"
            label="Email address"
            autocomplete="email"
            required
            requiredMessage="Please enter your email address."
            value={email}
            error={errors.email}
          />
          <Button type="submit" block>Send reset link</Button>
        </form>
      )
    }
    <div class="auth-links">
      <a class="inline-link" href="/account/sign-in">Back to sign in</a>
    </div>
  </AuthShell>
</BaseLayout>

<script>
  import '../../scripts/forms';
</script>
