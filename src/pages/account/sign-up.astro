---
// Account creation. Accounts are never required to buy (AGENT.md, Phase 2 → Authentication and Accounts).
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import { EMAIL_PATTERN, MIN_PASSWORD_LENGTH, confirmUrl, field, safeNext, type FieldErrors } from '../../lib/server/forms';

export const prerender = false;

const { supabase, user } = Astro.locals;
const next = safeNext(Astro.url.searchParams.get('next'));
if (user) return Astro.redirect(next);

const errors: FieldErrors = {};
let formError = '';
let name = '';
// Prefilled from the checkout confirmation's account prompt.
let email = Astro.url.searchParams.get('email')?.trim() ?? '';
let sentTo = '';

if (Astro.request.method === 'POST' && supabase) {
  const form = await Astro.request.formData();
  name = field(form, 'name');
  email = field(form, 'email');
  const password = form.get('password');

  if (!EMAIL_PATTERN.test(email)) errors.email = 'Please enter an email address like name@example.com.';
  if (typeof password !== 'string' || password.length < MIN_PASSWORD_LENGTH) {
    errors.password = `Please use at least ${MIN_PASSWORD_LENGTH} characters.`;
  }
  if (name.length > 120) errors.name = 'Please use a shorter name.';

  if (Object.keys(errors).length === 0) {
    const { error } = await supabase.auth.signUp({
      email,
      password: password as string,
      options: { data: { full_name: name || null }, emailRedirectTo: confirmUrl(Astro.url, next) },
    });
    if (!error) {
      // Supabase replies the same way for existing accounts, so this never reveals who has one.
      sentTo = email;
    } else if (error.code === 'weak_password') {
      errors.password = 'Please choose a stronger password — mix letters, numbers, or symbols.';
    } else if (error.status === 429) {
      formError = 'Too many attempts. Please wait a few minutes and try again.';
    } else {
      console.error('Sign-up failed', error);
      formError = "We couldn't create your account just now. Please try again shortly.";
    }
  }
}
---

<BaseLayout title="Create an account" description="Create a NATH & JAID account to keep your orders in one place." noindex>
  <AuthShell
    heading={sentTo ? 'Check your inbox.' : 'Create your account.'}
    lead={sentTo ? undefined : 'Keep your orders in one place. You never need an account to check out.'}
  >
    {
      sentTo ? (
        <p class="form-notice" role="status">
          We've sent a link to {sentTo}. Open it to confirm your email and finish creating your account.
        </p>
      ) : (
        <>
          {formError && <p class="form-alert" role="alert">{formError}</p>}
          <form method="post" data-validate="submit" novalidate aria-label="Create your account">
            <div class="field">
              <label for="name">Name <span class="optional">(optional)</span></label>
              <input id="name" name="name" type="text" class="input" autocomplete="name" value={name} maxlength="120" aria-describedby="name-error" aria-invalid={errors.name ? 'true' : undefined} />
              <p id="name-error" class="field-error" hidden={!errors.name}>{errors.name}</p>
            </div>
            <FormField
              id="email"
              name="email"
              type="email"
              label="Email address"
              autocomplete="email"
              required
              requiredMessage="Please enter your email address."
              value={email}
              error={errors.email}
            />
            <FormField
              id="password"
              name="password"
              type="password"
              label="Password"
              hint={`At least ${MIN_PASSWORD_LENGTH} characters.`}
              autocomplete="new-password"
              required
              minlength={MIN_PASSWORD_LENGTH}
              requiredMessage="Please choose a password."
              minlengthMessage={`Please use at least ${MIN_PASSWORD_LENGTH} characters.`}
              error={errors.password}
            />
            <Button type="submit" block>Create account</Button>
          </form>
          <div class="auth-links">
            <a class="inline-link" href={`/account/sign-in${next !== '/account' ? `?next=${encodeURIComponent(next)}` : ''}`}>Already have an account? Sign in</a>
            <a class="inline-link" href="/policies/privacy">Privacy</a>
          </div>
        </>
      )
    }
  </AuthShell>
</BaseLayout>

<script>
  import '../../scripts/forms';
</script>
