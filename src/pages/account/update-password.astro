---
// Reached from a reset email (signed in by /account/confirm) or from the account page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import { MIN_PASSWORD_LENGTH, type FieldErrors } from '../../lib/server/forms';

export const prerender = false;

const { supabase } = Astro.locals;
const errors: FieldErrors = {};
let formError = '';

if (Astro.request.method === 'POST' && supabase) {
  const form = await Astro.request.formData();
  const password = form.get('password');
  if (typeof password !== 'string' || password.length < MIN_PASSWORD_LENGTH) {
    errors.password = `Please use at least ${MIN_PASSWORD_LENGTH} characters.`;
  } else {
    const { error } = await supabase.auth.updateUser({ password });
    if (!error) return Astro.redirect('/account?done=password', 303);
    if (error.code === 'weak_password') errors.password = 'Please choose a stronger password — mix letters, numbers, or symbols.';
    else if (error.code === 'same_password') errors.password = 'Please choose a password you haven’t used here before.';
    else formError = "We couldn't update your password just now. Please try again shortly.";
  }
}
---

<BaseLayout title="Choose a new password" description="Choose a new password for your NATH & JAID account." noindex>
  <AuthShell heading="Choose a new password.">
    {formError && <p class="form-alert" role="alert">{formError}</p>}
    <form method="post" data-validate="submit" novalidate aria-label="Choose a new password">
      <FormField
        id="password"
        name="password"
        type="password"
        label="New password"
        hint={`At least ${MIN_PASSWORD_LENGTH} characters.`}
        autocomplete="new-password"
        required
        minlength={MIN_PASSWORD_LENGTH}
        requiredMessage="Please choose a password."
        minlengthMessage={`Please use at least ${MIN_PASSWORD_LENGTH} characters.`}
        error={errors.password}
      />
      <Button type="submit" block>Save password</Button>
    </form>
  </AuthShell>
</BaseLayout>

<script>
  import '../../scripts/forms';
</script>
