---
// Copy from brand/website-direction.md ("Contact Page"). Confirms on the page only until a provider is connected.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { company } from '../data/company';

const topics = ['A question about a scent', 'Gifting', 'Something else'];
---

<BaseLayout
  title="Contact"
  description="Questions about a scent, a gift, or the next collection? Send NATH & JAID a note."
>
  <section class="contact section">
    <div class="container contact-inner">
      <header class="contact-header">
        <h1>We'd love to hear from you.</h1>
        <p class="lead muted">Questions about a scent, a gift, or the next collection? Send us a note.</p>
        <p>
          Prefer email? Write to <a class="inline-link" href={`mailto:${company.email}`}>{company.email}</a>
        </p>
      </header>

      <div class="contact-form-wrap">
        <form class="contact-form" data-validate novalidate aria-label="Contact form">
          <div class="field">
            <label for="contact-name">Name</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              class="input"
              autocomplete="name"
              required
              data-required-message="Please enter your name."
              aria-describedby="contact-name-error"
            />
            <p id="contact-name-error" class="field-error" hidden></p>
          </div>

          <div class="field">
            <label for="contact-email">Email address</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              class="input"
              autocomplete="email"
              required
              data-required-message="Please enter your email address."
              aria-describedby="contact-email-error"
            />
            <p id="contact-email-error" class="field-error" hidden></p>
          </div>

          <div class="field">
            <label for="contact-topic">Topic <span class="optional">(optional)</span></label>
            <select id="contact-topic" name="topic" class="input">
              <option value="">Choose a topic</option>
              {topics.map((topic) => <option value={topic}>{topic}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="contact-message">Message</label>
            <textarea
              id="contact-message"
              name="message"
              class="input"
              rows="6"
              required
              data-required-message="Please enter a message."
              aria-describedby="contact-message-error"></textarea>
            <p id="contact-message-error" class="field-error" hidden></p>
          </div>

          <div>
            <Button type="submit">Send message</Button>
          </div>
        </form>

        <p class="form-success" tabindex="-1" data-form-success hidden>
          Thank you for your note. We'll be in touch soon.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/forms';
</script>

<style>
  .contact-inner {
    display: grid;
    gap: 3rem;
  }

  .contact-header {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    max-width: 32rem;
  }

  .contact-form {
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
  }

  @media (min-width: 960px) {
    .contact-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
</style>
